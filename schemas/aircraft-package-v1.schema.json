{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:flightsim:aircraft-package:v1",
  "title": "FlightSim aircraft package manifest v1",
  "description": "Data-only package. Runtime byte, portable-path/collision, binding, original-token/profile, embedded static GLB and rights checks remain separate; consult docs/aircraft-packages.md.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "aircraft"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,8})\\.(?:0|[1-9][0-9]{0,8})\\.(?:0|[1-9][0-9]{0,8})$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "const": "profile.json"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        }
      },
      "required": [
        "path",
        "version"
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180,
          "pattern": "^assets/(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+\\.glb$"
        },
        "format": {
          "const": "static-untextured-glb-v1"
        },
        "scene": {
          "const": 0
        }
      },
      "required": [
        "path",
        "format",
        "scene"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^https?://[^\\s]+$"
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "provenance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "credits": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "license": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "^https?://[^\\s]+$"
              },
              "text_path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 180,
                "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+){0,7}$"
              }
            },
            "required": [
              "name",
              "url",
              "text_path"
            ]
          }
        },
        "required": [
          "id",
          "url",
          "revision",
          "provenance",
          "credits",
          "license"
        ]
      }
    },
    "files": {
      "type": "array",
      "minItems": 3,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180,
            "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+){0,7}$"
          },
          "kind": {
            "enum": [
              "profile",
              "model",
              "documentation"
            ]
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16777216
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9.-]*$"
          }
        },
        "required": [
          "path",
          "kind",
          "size_bytes",
          "sha256",
          "source"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "profile"
                }
              }
            },
            "then": {
              "properties": {
                "path": {
                  "const": "profile.json"
                },
                "size_bytes": {
                  "maximum": 1048576
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "model"
                }
              }
            },
            "then": {
              "properties": {
                "path": {
                  "pattern": "^assets/(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+\\.glb$"
                },
                "size_bytes": {
                  "maximum": 16777216
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "documentation"
                }
              }
            },
            "then": {
              "properties": {
                "path": {
                  "pattern": "^docs/(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+\\.(txt|md)$"
                },
                "size_bytes": {
                  "maximum": 65536
                }
              }
            }
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "profile"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "model"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "version",
    "title",
    "profile",
    "model",
    "sources",
    "files"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "properties": {
              "version": {
                "const": 1
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "files": {
            "items": {
              "if": {
                "properties": {
                  "kind": {
                    "const": "profile"
                  }
                }
              },
              "then": {
                "properties": {
                  "size_bytes": {
                    "maximum": 131072
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
