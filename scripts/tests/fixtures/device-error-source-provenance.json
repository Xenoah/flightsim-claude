  "source_grammar": {
    "exception": "wgpu-hal strips D3D12 and severity prefix, emits message via log; only whole metadata-only messages are eligible. Driver prose plus metadata is explicitly unknown because object names have no trusted delimiter.",
    "hresult": "windows-result Display: code alone or message plus space and parenthesized code; code is uppercase eight hex digits with 0x prefix",
    "logger": "bevy_log default stderr tracing_subscriber Full; timestamp, level, target, message; dynamic spans explicitly rejected",
    "wait": "windows WAIT_EVENT Debug is WAIT_EVENT(value), not a bare HRESULT"
  },
