+@group(0) @binding(11) var<storage, read_write> meshlet_second_pass_instance_dispatch: DispatchIndirectArgs;
+@group(0) @binding(12) var<storage, read_write> meshlet_second_pass_instance_candidates: array<u32>;
+#else
