+    #[cfg_attr(feature = "pbr_multi_layer_material_textures", sampler(22))]
+    #[cfg(feature = "pbr_multi_layer_material_textures")]
+    #[dependency]
+    pub clearcoat_texture: Option<Handle<Image>>,
+
