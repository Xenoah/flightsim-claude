feb4971395370f09699e7f45f2e405fbf24b3b"}]},{"sha":"fd818979d7a55eb25a7ab9c9c47e969860d6a749","node_id":"MDY6Q29tbWl0ODc2ODExMDA6ZmQ4MTg5NzlkN2E1NWViMjVhN2FiOWM5YzQ3ZTk2OTg2MGQ2YTc0OQ==","commit":{"author":{"name":"Pat Hickey","email":"pat@moreproductive.org","date":"2020-09-17T17:39:49Z"},"committer":{"name":"Kang Seonghoon","email":"public+git@mearie.org","date":"2020-12-09T18:26:16Z"},"message":"use Rust 2018 and built-in support for expression proc macros\n\nRust 1.45 and up supports expression proc macros, so the proc_macro_hack\nlibrary that was previously required is no longer necessary.\n\nAdditionally, update each crate to use Rust 2018, which means we can\nexplicitly import macros via `use hexf::{hexf32, hexf64};`, rather than\nby `#[macro_use] extern crate hexf;`.\n\nFix warnings around deprecated triple-elipsis `...`, the replacement\nsyntax for inclusive ranges is `..=`.\n\nUses the latest `syn` crate, which is now in the semver stable 1.0.x\nseries.\n\nrustfmted with rustfmt 1.4.18 (ships with rust 1.46). Apoligies that\nthis makes the diff harder to read, my editor did this automatically.","tree":{"sha":"cace5c5990a999338a2792a82cce9346df51fff9","url":"https://api.github.com/repos/lifthrasiir/hexf/git/trees/cace5c5990a999338a2792a82cce9346df51fff9"},"url":"https://api.github.com/repos/lifthrasiir/hexf/git/commits/fd818979d7a55eb25a7ab9c9c47e969860d6a749","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/lifthrasiir/hexf/commits/fd818979d7a55eb25a7ab9c9c47e969860d6a749","html_url":"https://github.com/lifthrasiir/hexf/commit/fd818979d7a55eb25a7ab9c9c47e969860d6a749","comments_url":"https://api.github.com/repos/lifthrasiir/hexf/commits/fd818979d7a55eb25a7ab9c9c47e969860d6a749/comments","author":{"login":"pchickey","id":118618,"node_id":"MDQ6VXNlcjExODYxOA==","avatar_url":"https://avatars.githubusercontent.com/u/118618?v=4","gravatar_id":"","url":"