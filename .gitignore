/target/
**/*.rs.bk

# 生成されたタイル・DEM キャッシュ。数百 GB になり得るのでコミットしない。
/data/cache/
/data/tiles/
# 利用者が用意する OSM 地域抽出と、そこから焼いた実行時空港 DB。
# ODbL の帰属・share-alike 条件は配布者ごとに判断が必要なため、リポジトリには同梱しない。
/data/**/*.osm
/data/**/*.osm.pbf
/data/**/*.fsairports
/assets/generated/
# Meshy で生成した機体モデルのうち、同梱すると決めたものは追跡する
# （有料プランで生成しており再配布可。ATTRIBUTION.md を参照）。
# preview 段階の中間生成物は refine すれば作り直せるので入れない。
/assets/aircraft/*
!/assets/aircraft/light_single.glb

# API キー。**中身を絶対にコミットしない。**
# 書き方は .env.example を参照（そちらは追跡する）。
.env
/config/secrets.toml

# IDE
.vscode/
.idea/
*.iml

# Windows
Thumbs.db
desktop.ini

# 合成 DEM とそこから焼いたタイル。作り直せるのでコミットしない。
/data/synthetic.tif

# 実行して作った飛行の記録と音。**成果物であって、ソースではない。**
# `F9` の保存と `record_takeoff` / `render_engine` の例が既定でここへ書く。
*.fsreplay
*.wav
